;; Seatbelt profile for scout sorties.
;; Goal: a scout's shell can touch its worktree and the tool caches it needs
;; to run the gate, and nothing else on the machine. Reads of other repos and
;; secrets are denied; writes anywhere but the worktree, tmp, and caches are
;; denied (no ~/.zshrc append, no cron, no git hooks in other repos).
;;
;; Invoke: sandbox-exec -D WORKTREE=<abs> -f scout_sandbox.sb <cmd...>
;;
;; Known residual (v1): network egress is broad (Seatbelt can't scope it to one
;; host), and the scout can still read its own OpenRouter key via pi's config.
;; Both are bounded by the OpenRouter credit cap, not by this profile.

(version 1)
(allow default)                       ; permissive base; carve out the dangerous bits below

;; ---- reads: deny the crown jewels and every other repo ----
(deny file-read*
  (subpath "/Users/romello/code")               ; all other repos + scout's own notebook/devlog (blinding)
  (subpath "/Users/romello/.ssh")
  (subpath "/Users/romello/.aws")
  (subpath "/Users/romello/.gnupg")
  (subpath "/Users/romello/.config/gh")
  (subpath "/Users/romello/.config/gcloud")
  (subpath "/Users/romello/.claude")
  (subpath "/Users/romello/.pi/agent/sessions")  ; other pi sessions (cross-run contamination)
  (subpath "/Users/romello/Desktop")
  (subpath "/Users/romello/Documents")
  (subpath "/Users/romello/Library/Keychains")
  (literal "/Users/romello/.netrc")
  (literal "/Users/romello/.npmrc")
  (literal "/Users/romello/.zsh_history")
  (literal "/Users/romello/.bash_history"))

;; ---- writes: deny anywhere under home, then re-allow only the safe spots ----
(deny file-write* (subpath "/Users/romello"))
(allow file-write*
  (subpath (param "WORKTREE"))
  (subpath "/Users/romello/.pi")                 ; pi's own runtime state
  (subpath "/Users/romello/.cache/uv")
  (subpath "/Users/romello/.cache/ruff")
  (subpath "/Users/romello/.cache/uvx")
  (subpath "/Users/romello/.local/share/uv")     ; uvx installs tools here
  (subpath "/Users/romello/.local/state/uv"))
;; tmp (worktree lives here) and /dev are outside home; (allow default) covers them.
