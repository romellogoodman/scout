;; Seatbelt profile for recon sorties (read-only).
;;
;; Recon must READ the target repo — which often lives under ~/code — so unlike
;; the build profile this one does NOT deny ~/code. Instead it denies all writes
;; (recon changes nothing) and denies reads of secrets. The scout can read the
;; target and the rest of the tree; it cannot write anywhere but tmp/caches, and
;; cannot read ssh keys, cloud creds, or keychains.
;;
;; Parameters (via sandbox-exec -D): HOME — the user's home directory. REPO and
;; WORKTREE are accepted for call-site symmetry with the build profile but unused
;; (recon grants no writes and blinds nothing).
;;
;; Residuals (v1): broad network egress and the scout reading its own provider
;; key are not closed here — bounded by the OpenRouter credit cap.

(version 1)
(allow default)

;; ---- reads: deny the crown jewels ----
(deny file-read*
  (subpath (string-append (param "HOME") "/.ssh"))
  (subpath (string-append (param "HOME") "/.aws"))
  (subpath (string-append (param "HOME") "/.gnupg"))
  (subpath (string-append (param "HOME") "/.config/gh"))
  (subpath (string-append (param "HOME") "/.config/gcloud"))
  (subpath (string-append (param "HOME") "/Library/Keychains"))
  (subpath (string-append (param "HOME") "/.netrc"))
  (subpath (string-append (param "HOME") "/.npmrc"))
  (subpath (string-append (param "HOME") "/.zsh_history"))
  (subpath (string-append (param "HOME") "/.bash_history")))

;; ---- writes: recon modifies nothing under home except pi/uv scratch ----
(deny file-write* (subpath (param "HOME")))
(allow file-write*
  (subpath (string-append (param "HOME") "/.pi"))
  (subpath (string-append (param "HOME") "/.cache/uv"))
  (subpath (string-append (param "HOME") "/.cache/ruff"))
  (subpath (string-append (param "HOME") "/.cache/uvx"))
  (subpath (string-append (param "HOME") "/.local/share/uv"))
  (subpath (string-append (param "HOME") "/.local/state/uv")))
;; tmp (pi's session) and /dev are outside home; (allow default) covers them.
